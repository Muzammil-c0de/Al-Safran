# Copy this file to .env and fill in your real values.

PORT=5000

# Comma-separated list of allowed frontend origins (leave empty to allow all in dev)
CORS_ORIGIN=http://localhost:5173

# ---- Neon (Postgres) ----
# Neon dashboard -> your project -> Connection Details -> copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Cloudflare R2 ----
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create token (Object Read & Write)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=alsafran
# Public URL of the bucket (R2 -> bucket -> Settings -> Public access: r2.dev URL or custom domain)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---- Admin ----
# Long random secret used to log in to /admin (add/remove projects, read messages)
ADMIN_TOKEN=change-me-to-a-long-random-string
